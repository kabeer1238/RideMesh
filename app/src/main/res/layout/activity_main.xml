<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ScrollView android:id="@+id/screenHome" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="Ride Mesh" android:scaleType="centerInside" android:src="@drawable/ridemesh_icon" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.12" android:text="RIDE MESH" android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BY AUTOPILOTINDIA" android:textColor="@color/accent" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/openSettings" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="SETTINGS" android:textColor="@color/muted" android:textSize="11sp" />
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="128dp" android:layout_marginTop="14dp" android:adjustViewBounds="true" android:contentDescription="Ride Mesh by AutopilotIndia" android:scaleType="centerInside" android:src="@drawable/ridemesh_logo" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.06" android:text="ONE RIDING\nCOMMUNICATION GROUP" android:textColor="@color/white" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:text="Any phone. Any compatible Bluetooth helmet. Internet when available, local mesh when coverage disappears." android:textColor="@color/muted" android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/createRide" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp" android:text="CREATE RIDE" android:textColor="#00201D" android:textStyle="bold" app:backgroundTint="@color/accent" app:cornerRadius="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/joinRide" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="JOIN RIDE" android:textColor="@color/white" android:textStyle="bold" app:cornerRadius="12dp" app:strokeColor="@color/border" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="LIVE STATUS" android:textColor="@color/faint" android:textSize="11sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/panel_bg" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/homeNetworkStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="●  Hybrid network ready" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/homeAudioStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Bluetooth helmet optional • phone audio available" android:textColor="@color/muted" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Battery smart: silence suppression + mesh sleep on stable Internet" android:textColor="@color/muted" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ScrollView android:id="@+id/screenSetup" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/backHome" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="52dp" android:layout_height="44dp" android:minWidth="0dp" android:text="‹" android:textColor="@color/white" android:textSize="28sp" />
                <TextView android:id="@+id/setupTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-condensed" android:gravity="center" android:letterSpacing="0.08" android:text="RIDE LOBBY" android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold" />
                <View android:layout_width="52dp" android:layout_height="1dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_bg" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR RIDER NAME" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
                <EditText android:id="@+id/riderName" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="4dp" android:backgroundTint="@color/accent" android:hint="Rider name" android:inputType="textPersonName" android:maxLength="18" android:textColor="@color/white" android:textColorHint="@color/faint" android:textSize="17sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="RIDE CODE" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
                <EditText android:id="@+id/rideCode" android:layout_width="match_parent" android:layout_height="52dp" android:backgroundTint="@color/accent" android:hint="RM4825" android:inputType="textCapCharacters" android:maxLength="12" android:text="RIDE01" android:textColor="@color/white" android:textColorHint="@color/faint" android:textSize="18sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/showQr" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="SHOW QR" android:textColor="@color/white" app:cornerRadius="10dp" app:strokeColor="@color/border" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/scanQr" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="SCAN QR" android:textColor="@color/white" app:cornerRadius="10dp" app:strokeColor="@color/border" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/findNearby" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="FIND NEARBY RIDEMESH RIDERS" android:textColor="@color/accent" android:textStyle="bold" app:cornerRadius="10dp" app:strokeColor="@color/accent" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="NEARBY RIDERS" android:textColor="@color/faint" android:textSize="11sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/nearbyUsers" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="AUDIO" android:textColor="@color/faint" android:textSize="11sp" android:textStyle="bold" />
            <RadioGroup android:id="@+id/audioRoute" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/panel_bg" android:orientation="vertical" android:padding="12dp">
                <RadioButton android:id="@+id/routeAuto" android:layout_width="match_parent" android:layout_height="46dp" android:buttonTint="@color/accent" android:checked="true" android:text="Auto — helmet if connected, otherwise phone" android:textColor="@color/white" />
                <RadioButton android:id="@+id/routePhone" android:layout_width="match_parent" android:layout_height="46dp" android:buttonTint="@color/accent" android:text="Phone speaker + microphone" android:textColor="@color/white" />
                <RadioButton android:id="@+id/routeHelmet" android:layout_width="match_parent" android:layout_height="46dp" android:buttonTint="@color/accent" android:text="Bluetooth helmet / headset" android:textColor="@color/white" />
            </RadioGroup>
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/batterySaver" android:layout_width="match_parent" android:layout_height="66dp" android:layout_marginTop="14dp" android:background="@drawable/panel_bg" android:checked="true" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Battery Smart Mode\nSleep local mesh while Internet is stable" android:textColor="@color/white" android:textSize="13sp" app:thumbTint="@color/accent" app:trackTint="@color/accent_dim" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="LAB / BENCH TEST" android:textColor="@color/faint" android:textSize="11sp" android:textStyle="bold" />
            <RadioGroup android:id="@+id/labRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/panel_bg" android:orientation="horizontal" android:padding="10dp">
                <RadioButton android:id="@+id/labNormal" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1.4" android:buttonTint="@color/accent" android:checked="true" android:text="Normal" android:textColor="@color/white" />
                <RadioButton android:id="@+id/labA" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:buttonTint="@color/accent" android:text="A" android:textColor="@color/white" />
                <RadioButton android:id="@+id/labB" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:buttonTint="@color/accent" android:text="B" android:textColor="@color/white" />
                <RadioButton android:id="@+id/labC" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:buttonTint="@color/accent" android:text="C" android:textColor="@color/white" />
            </RadioGroup>
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/hardwarePtt" android:layout_width="match_parent" android:layout_height="52dp" android:text="Use phone volume buttons as bench PTT" android:textColor="@color/muted" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/startRide" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="22dp" android:text="START / JOIN RIDE" android:textColor="#00201D" android:textStyle="bold" app:backgroundTint="@color/accent" app:cornerRadius="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="DIAGNOSTICS" android:textColor="@color/faint" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/logView" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="8dp" android:background="@drawable/panel_bg" android:fontFamily="monospace" android:gravity="top" android:padding="12dp" android:scrollbars="vertical" android:text="Ready." android:textColor="@color/muted" android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/screenActive" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="38dp" android:layout_height="38dp" android:contentDescription="Ride Mesh" android:src="@drawable/ridemesh_icon" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:fontFamily="sans-serif-condensed" android:letterSpacing="0.08" android:text="RIDE MESH" android:textColor="@color/accent" android:textSize="18sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/activeSettings" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="0dp" android:text="STATUS" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/activeRideCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:fontFamily="sans-serif-condensed" android:gravity="center" android:letterSpacing="0.08" android:text="RIDE01" android:textColor="@color/muted" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/riderCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="sans-serif-condensed" android:gravity="center" android:text="0 RIDERS CONNECTED" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/meshStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="HYBRID: CONNECTING" android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="86dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/panel_bg" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETWORK" android:textColor="@color/faint" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/networkTile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="CONNECTING" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="86dp" android:layout_marginHorizontal="5dp" android:layout_weight="1" android:background="@drawable/panel_bg" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUDIO" android:textColor="@color/faint" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/audioTile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="PHONE" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="86dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/panel_bg" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POWER" android:textColor="@color/faint" android:textSize="9sp" android:textStyle="bold" />
                <TextView android:id="@+id/powerTile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="SMART" android:textColor="@color/green" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/handsFreeIndicator" android:layout_width="176dp" android:layout_height="176dp" android:layout_gravity="center" android:background="@drawable/circle_mic_bg" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MIC" android:textColor="@color/accent" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="HANDS-FREE" android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/audioStatus" android:layout_width="132dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:maxLines="2" android:text="Waiting for route" android:textColor="@color/muted" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/benchTalkContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/pttLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BENCH TEST" android:textColor="@color/muted" android:textSize="11sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/ptt" android:layout_width="176dp" android:layout_height="176dp" android:layout_marginTop="12dp" android:text="BENCH TALK" android:textColor="@color/accent" android:textStyle="bold" app:backgroundTint="@color/panel" app:cornerRadius="88dp" app:strokeColor="@color/accent" app:strokeWidth="2dp" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/activeBluetooth" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:text="BLUETOOTH" android:textColor="@color/muted" android:textSize="9sp" app:cornerRadius="10dp" app:strokeColor="@color/border" />
            <com.google.android.material.button.MaterialButton android:id="@+id/activeNetwork" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginHorizontal="5dp" android:layout_weight="1" android:text="NETWORK" android:textColor="@color/muted" android:textSize="9sp" app:cornerRadius="10dp" app:strokeColor="@color/border" />
            <com.google.android.material.button.MaterialButton android:id="@+id/activeSos" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginHorizontal="5dp" android:layout_weight="1" android:text="SOS" android:textColor="@color/danger" android:textSize="10sp" android:textStyle="bold" app:cornerRadius="10dp" app:strokeColor="@color/danger" />
            <com.google.android.material.button.MaterialButton android:id="@+id/activeStop" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="5dp" android:layout_weight="1" android:text="STOP" android:textColor="@color/white" android:textSize="9sp" app:cornerRadius="10dp" app:strokeColor="@color/border" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>